<Application x:Class="ScaleScanLite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ScaleScanLite.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis"/>
            <views:StatusBrushConverter x:Key="StatusBrush"/>
            <views:NoticeLevelBrushConverter x:Key="NoticeBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
