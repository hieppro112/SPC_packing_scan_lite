<Window x:Class="ScaleScanLite.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Scan Lite - thu nhỏ"
        Width="284" Height="212"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border CornerRadius="12" Background="{StaticResource DarkBg}" BorderBrush="#3A3F55" BorderThickness="1.5"
            ClipToBounds="True" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Thanh trên -->
            <Grid Background="#33FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsScaleConnected, Converter={StaticResource StatusBrush}}"/>
                    <TextBlock Text="Scale Scan Lite" Foreground="White" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="⤢" Width="28" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="White" FontSize="13" Cursor="Hand" ToolTip="Phóng to lại" Click="Restore_Click"/>
            </Grid>

            <!-- Số cân, mã PO và trạng thái -->
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,4,12,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding WeightText}" Foreground="White" FontFamily="Consolas" FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text=" g" Foreground="#C7D0FC" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsWeightStable, Converter={StaticResource StatusBrush}}"/>
                        <TextBlock Text="{Binding PoCode}" Foreground="#C7D0FC" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <!-- Nhiều PO cùng gói: nhãn giữ đến khi cân xong, nhấp nháy một lần mỗi khi thêm PO -->
                    <Border x:Name="GroupPill" HorizontalAlignment="Center" Margin="0,5,0,0" Padding="10,1" CornerRadius="10"
                            Background="#4F6BED" RenderTransformOrigin="0.5,0.5"
                            Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1.35" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1.35" To="1" Duration="0:0:0.45">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <TextBlock Text="{Binding GroupBadgeText, NotifyOnTargetUpdated=True}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                    </Border>
                    <!-- Số lượng (Qty): nổi bật nhưng nhỏ hơn số cân -->
                    <Border HorizontalAlignment="Center" Margin="0,5,0,0" Padding="12,2" CornerRadius="6"
                            Background="#33FBBF24" BorderBrush="#FBBF24" BorderThickness="1"
                            Visibility="{Binding HasPoItems, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SL " Foreground="#FCD34D" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding QuantitySummary}" Foreground="#FDE68A" FontFamily="Consolas" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding StateText}" Foreground="#9AA3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <!-- Nhắc đặt hàng lên cân: phủ lên số kg 2 giây (hộp rơi xuống bàn cân) rồi trở về bình thường -->
                <Border x:Name="PlaceHintOverlay" Background="{StaticResource DarkBg}"
                        Visibility="{Binding IsPlaceHintVisible, Converter={StaticResource BoolToVis}}"
                        IsVisibleChanged="PlaceHintOverlay_IsVisibleChanged">
                    <Border.Resources>
                        <Storyboard x:Key="DropBox" RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintBox" Storyboard.TargetProperty="(Canvas.Top)">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-26"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="22">
                                    <EasingDoubleKeyFrame.EasingFunction><BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="3"/></EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                                <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="22"/>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HintBox" Storyboard.TargetProperty="Opacity">
                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:0.85" Value="1"/>
                                <LinearDoubleKeyFrame KeyTime="0:0:1.0" Value="0.2"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </Border.Resources>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas Width="120" Height="64" HorizontalAlignment="Center">
                            <!-- bàn cân -->
                            <Rectangle Canvas.Left="14" Canvas.Top="52" Width="92" Height="7" RadiusX="3" RadiusY="3" Fill="#9AA3B8"/>
                            <Rectangle Canvas.Left="52" Canvas.Top="59" Width="16" Height="4" Fill="#6B7390"/>
                            <!-- thùng hàng -->
                            <Canvas x:Name="HintBox" Canvas.Left="38" Canvas.Top="-26" Width="44" Height="30">
                                <Rectangle Width="44" Height="30" RadiusX="3" RadiusY="3" Fill="#F59E0B"/>
                                <Rectangle Canvas.Left="19" Width="6" Height="30" Fill="#FDE68A"/>
                            </Canvas>
                        </Canvas>
                        <TextBlock Text="{Binding PlaceHintText}" Foreground="#FDE68A" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding PoCode}" Foreground="#C7D0FC" FontFamily="Consolas" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Thông báo nổi -->
                <Border VerticalAlignment="Bottom" Padding="10,8"
                        Background="{Binding ToastLevel, Converter={StaticResource NoticeBrush}}"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                               TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
