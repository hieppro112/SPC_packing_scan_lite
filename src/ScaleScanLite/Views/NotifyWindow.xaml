<Window x:Class="ScaleScanLite.Views.NotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông báo"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False">

    <Border Margin="14" CornerRadius="12" Background="{StaticResource BgWhite}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TopBar" Grid.Row="0" CornerRadius="12,12,0,0"/>

            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconCircle" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top">
                        <TextBlock x:Name="TxtIcon" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" Width="270">
                        <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtMessage" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Foreground="{StaticResource TxtSub}"/>
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <TextBlock x:Name="TxtCountdown" FontSize="11" Foreground="{StaticResource TxtMuted}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnOk" Content="Xác nhận" Style="{StaticResource BtnPrimary}"
                            HorizontalAlignment="Right" MinWidth="96" IsDefault="True" IsCancel="True"
                            Click="BtnOk_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
