<Window x:Class="ScaleScanLite.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Scan Lite"
        Width="1180" Height="780" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        FontFamily="Segoe UI" Icon="/Views/icons8-packing-48.png">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================= Thanh tiêu đề ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgWhite}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <TextBlock Text="⚖" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Scale Scan Lite" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Width="1" Height="15" Background="{StaticResource BorderBrush}" Margin="10,0"/>
                    <TextBlock Text="Cân đóng gói theo PO" FontSize="12"
                               Foreground="{StaticResource TxtMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource Tile}" CornerRadius="14" Padding="10,4" Margin="0,0,8,0"
                            ToolTip="{Binding ScaleStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsScaleConnected, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="Cân" FontSize="12" Foreground="{StaticResource TxtSub}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" CornerRadius="14" Padding="10,4"
                            ToolTip="{Binding DbStatusText}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsDbOnline, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="SQL" FontSize="12" Foreground="{StaticResource TxtSub}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" CornerRadius="14" Padding="10,4" Margin="8,0,0,0"
                            ToolTip="{Binding ScannerStatusText}"
                            Visibility="{Binding IsScannerEnabled, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding IsScannerActive, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock Text="Máy quét" FontSize="12" Foreground="{StaticResource TxtSub}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource BtnWindow}" Content="➖" ToolTip="Thu nhỏ xuống góc màn hình"
                            Click="Minimize_Click"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource BtnWindow}" Content="🔳" Click="Maximize_Click"/>
                    <Button Style="{StaticResource BtnWindowClose}" Content="✖️" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Thân ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thanh bên -->
            <Border Background="{StaticResource BgWhite}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="CHÍNH" Style="{StaticResource Caption}" Margin="12,0,0,6"/>
                        <Button Style="{StaticResource BtnNav}" Click="NavDashboard_Click" Content="▦   Màn hình cân"
                                Background="{StaticResource AccentLight}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource BtnNav}" Click="NavHistory_Click" Content="☰   Lịch sử cân"/>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding ExportExcelCommand}" Content="↑   Xuất Excel"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource BtnNav}" Command="{Binding OpenSettingsCommand}" Content="⚙   Cài đặt"/>
                        <Button Style="{StaticResource BtnNav}" Command="{Binding CompactCommand}" Content="⌟   Thu nhỏ góc màn hình"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nội dung -->
            <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,20">

                    <!-- Đầu trang -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cân kí theo PO" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StateText}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{StaticResource TxtSub}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Nhập mã + cân -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="⌗  Quét hoặc nhập mã PO" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EntryBox" FontFamily="Consolas" FontSize="18" Padding="12,10"
                                             Text="{Binding ManualCode, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Quét bằng máy quét USB hoặc gõ mã PO rồi nhấn Enter">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SubmitManualCodeCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Command="{Binding SubmitManualCodeCommand}"
                                            Content="Gửi" Padding="24,12" FontSize="13"/>
                                </Grid>

                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TxtMuted}"
                                           TextWrapping="Wrap" TextTrimming="None"
                                           Text="Để con trỏ trong ô trên rồi quét bằng máy quét USB (hoặc gõ mã rồi nhấn Enter). Muốn quét khi đang dùng app khác, bật &quot;Nghe máy quét USB&quot; trong Cài đặt."/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel>
                                            <TextBlock Text="MÃ VỪA QUÉT" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding LastCode, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontWeight="Bold"
                                                     Foreground="{StaticResource Accent}" ToolTip="{Binding LastCode}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Tile}">
                                        <StackPanel>
                                            <TextBlock Text="THỜI GIAN QUÉT" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ScanTime}" FontFamily="Consolas" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,12,0,0" CornerRadius="8" Background="{StaticResource BgLight}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="8,0,0,8" Background="{Binding LastResultLevel, Converter={StaticResource NoticeBrush}}"/>
                                        <StackPanel Grid.Column="1" Margin="12,9">
                                            <TextBlock Text="KẾT QUẢ CÂN GẦN NHẤT" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding LastResultText}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextTrimming="None"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <!-- Khối lượng -->
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="KHỐI LƯỢNG HIỆN TẠI" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource AccentLight}" BorderBrush="#C7D0FC" BorderThickness="1.5"
                                            CornerRadius="10" Padding="12,14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding WeightText}" FontSize="46" FontWeight="Bold"
                                                           FontFamily="Consolas" Foreground="{StaticResource Accent}"/>
                                                <TextBlock Text=" g" FontSize="18" FontWeight="SemiBold" Foreground="#7B8FE8"
                                                           VerticalAlignment="Bottom" Margin="2,0,0,8"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <Ellipse Style="{StaticResource StatusDot}"
                                                         Fill="{Binding IsWeightStable, Converter={StaticResource StatusBrush}}"/>
                                                <TextBlock FontSize="12" Foreground="{StaticResource TxtSub}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="Đang chờ số ổn định"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWeightStable}" Value="True">
                                                                    <Setter Property="Text" Value="Số cân ổn định"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding ConfirmCommand}"
                                                Padding="0,11" Content="✓  Xác nhận cân" ToolTip="Lưu ngay số cân hiện tại"/>
                                        <Button Grid.Column="2" Style="{StaticResource BtnOutline}" Command="{Binding ResetCommand}"
                                                Padding="14,11" Content="↺  Reset" ToolTip="Xóa PO hiện tại và quét lại"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Thông tin PO -->
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="📋  Thông tin PO hiện tại" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource AmberSoft}" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="7" Padding="12,9" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="MÃ PO" Style="{StaticResource Caption}" Foreground="#B45309" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding PoCode}" FontSize="17" FontWeight="Bold" FontFamily="Consolas"
                                                       Foreground="#92400E"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="PHCD" Foreground="{StaticResource TxtMuted}" FontSize="12" Margin="0,3,16,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Phcd}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Text="PHTX" Foreground="{StaticResource TxtMuted}" FontSize="12" Margin="0,3,16,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Phtx}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Right" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Text="PSTX" Foreground="{StaticResource TxtMuted}" FontSize="12" Margin="0,3,16,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Pstx}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GreenDark}" HorizontalAlignment="Right" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Text="Số lượng" Foreground="{StaticResource TxtMuted}" FontSize="12" Margin="0,3,16,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding QuantityText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Amber}" HorizontalAlignment="Right" Margin="0,3"/>
                                        <TextBlock Grid.Row="4" Text="Khối lượng chuẩn" Foreground="{StaticResource TxtMuted}" FontSize="12" Margin="0,3,16,3"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExpectedKgText}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Margin="0,3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Lịch sử -->
                    <Border x:Name="HistoryCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="☰  Lịch sử cân gần đây" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnOutline}" Command="{Binding RefreshCommand}" Content="↻  Làm mới" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource BtnOutline}" Command="{Binding ExportExcelCommand}" Content="↓  Xuất Excel"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nhập đầu mã PO rồi nhấn Enter">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Command="{Binding SearchCommand}"
                                        Content="🔍  Tìm" Padding="16,7"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Rows}" PreviewMouseWheel="Grid_PreviewMouseWheel"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.6*"/>
                                    <DataGridTextColumn Header="MÃ PO" Binding="{Binding Aufnr}" Width="1.6*"/>
                                    <DataGridTextColumn Header="PHCD" Binding="{Binding Phcd}" Width="1.1*"/>
                                    <DataGridTextColumn Header="PHTX" Binding="{Binding Phtx}" Width="1.4*"/>
                                    <DataGridTextColumn Header="PSTX" Binding="{Binding Pstx}" Width="1*"/>
                                    <DataGridTextColumn Header="SỐ LƯỢNG" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="1*"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTextColumn Header="KHỐI LƯỢNG (G)" Binding="{Binding Kg, StringFormat={}{0:0.000}}" Width="1.4*"
                                                        ElementStyle="{StaticResource CellRight}"/>
                                    <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding WeighedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="1.7*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding RangeSummary}" FontSize="12" Foreground="{StaticResource TxtMuted}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource BtnPage}" Content="«" Command="{Binding FirstPageCommand}"
                                                IsEnabled="{Binding CanGoPrevious}" ToolTip="Trang đầu"/>
                                        <Button Style="{StaticResource BtnPage}" Content="‹" Command="{Binding PreviousPageCommand}"
                                                IsEnabled="{Binding CanGoPrevious}" ToolTip="Trang trước"/>
                                        <TextBlock Text="{Binding PageSummary}" FontSize="12" FontWeight="SemiBold" Margin="10,0"
                                                   VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource BtnPage}" Content="›" Command="{Binding NextPageCommand}"
                                                IsEnabled="{Binding CanGoNext}" ToolTip="Trang sau"/>
                                        <Button Style="{StaticResource BtnPage}" Content="»" Command="{Binding LastPageCommand}"
                                                IsEnabled="{Binding CanGoNext}" ToolTip="Trang cuối"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Hiển thị" FontSize="12" Foreground="{StaticResource TxtMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Width="70" Height="30" ItemsSource="{Binding PageSizes}"
                                                  SelectedItem="{Binding SelectedPageSize}"/>
                                        <TextBlock Text="dòng/trang" FontSize="12" Foreground="{StaticResource TxtMuted}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Thanh trạng thái ================= -->
        <Border Grid.Row="2" Background="{StaticResource BgWhite}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TxtSub}" MaxWidth="700"/>
                    <TextBlock Text="{Binding PendingText}" FontSize="11" Foreground="{StaticResource Amber}" FontWeight="SemiBold"
                               Margin="16,0,0,0"
                               Visibility="{Binding PendingText, Converter={StaticResource NotEmptyToVis}}"/>
                </StackPanel>
                <TextBlock Text="Scale Scan Lite v1.0" FontSize="11" Foreground="{StaticResource TxtMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
